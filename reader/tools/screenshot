#!/usr/bin/env bash
# Render samples under Omarchy themes to PNGs, offscreen.
#
#   tools/screenshot [sample…] [--themes a,b,…] [--size wide|narrow|both]
#                    [--pages N] [--opt key=value …] [--tag name]
#
# Samples are names under samples/ (kitchen-sink, real/adr-0003) or paths.
# Default: every samples/*.md, the six review themes, both sizes, 3 pages.
# Writes shots/<theme>/<sample>[-narrow][-tag]-<n>.png at 1400×1000 (wide)
# and 800×1000 (narrow), and prints any QML warning from the qs log: the
# log must stay clean. Never touches the real theme (OMARKY_THEME_DIR).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SUITE="$(cd "$ROOT/.." && pwd)"
THEMES="gruvbox,tokyo-night,catppuccin-latte,rose-pine,flexoki-light,matte-black"
SIZE=both
PAGES=3
TAG=""
OPTS="{}"
SAMPLES=()

while [ $# -gt 0 ]; do
  case "$1" in
    --themes) THEMES="$2"; shift 2 ;;
    --size) SIZE="$2"; shift 2 ;;
    --pages) PAGES="$2"; shift 2 ;;
    --tag) TAG="-$2"; shift 2 ;;
    --opt)
      OPTS="$(python3 -c 'import json,sys; o=json.loads(sys.argv[1]); k,v=sys.argv[2].split("=",1); o[k]=json.loads(v) if v[:1] in "0123456789[{tf\"" else v; print(json.dumps(o))' "$OPTS" "$2")"
      shift 2 ;;
    -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    *) SAMPLES+=("$1"); shift ;;
  esac
done

if [ ${#SAMPLES[@]} -eq 0 ]; then
  for f in "$SUITE"/samples/*.md; do SAMPLES+=("$(basename "$f" .md)"); done
fi

theme_dir() {
  local t="$1"
  if [ "$t" = current ]; then echo "$HOME/.local/state/omarchy/current/theme"; return; fi
  for d in "$HOME/.config/omarchy/themes/$t" "$HOME/.local/share/omarchy/themes/$t"; do
    [ -f "$d/colors.toml" ] && { echo "$d"; return; }
  done
  echo "unknown theme: $t" >&2; exit 1
}

jobs_json() {
  local out="$1"
  python3 - "$ROOT" "$out" "$SIZE" "$PAGES" "$TAG" "$OPTS" "${SAMPLES[@]}" <<'PY'
import json, os, sys
root, out, size, pages, tag, opts = sys.argv[1:7]
samples = sys.argv[7:]
sizes = {"wide": [("", 1400, 1000)], "narrow": [("-narrow", 800, 1000)]}
sizes["both"] = sizes["wide"] + sizes["narrow"]
jobs = []
for s in samples:
    path = s if os.path.exists(s) else os.path.join(root, "../samples", s + ".md")
    path = os.path.abspath(path)
    name = os.path.splitext(os.path.relpath(path, os.path.join(root, "../samples")))[0].replace("/", "-") \
        if path.startswith(os.path.join(root, "../samples")) else os.path.splitext(os.path.basename(path))[0]
    for suffix, w, h in sizes[size]:
        jobs.append({"file": path, "name": name + suffix + tag, "w": w, "h": h,
                     "pages": int(pages), "opts": json.loads(opts)})
print(json.dumps({"out": out, "jobs": jobs}))
PY
}

# Where services/Highlight.qml writes the generated KSH themes (bin/omarky does the same).
export XDG_DATA_DIRS="$HOME/.local/share/omarky/ksh:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

pids=()
for theme in ${THEMES//,/ }; do
  dir="$(theme_dir "$theme")"
  out="$ROOT/shots/$theme"
  mkdir -p "$out"
  jobs_json "$out" >"$out/.jobs.json"
  (
    OMARKY_THEME_DIR="$dir" OMARKY_SHOT="$out/.jobs.json" QT_QPA_PLATFORM=offscreen \
      timeout 300 qs --log-rules "qt.qml.usedbeforedeclared=false" -p "$ROOT/ui/shell.qml" >"$out/qs.log" 2>&1 || echo "qs exited $? for $theme" >&2
  ) &
  pids+=($!)
  sleep 0.4   # simultaneous qs starts race on Quickshell's runtime symlinks
done
for p in "${pids[@]}"; do wait "$p"; done

status=0
for theme in ${THEMES//,/ }; do
  log="$ROOT/shots/$theme/qs.log"
  noise='WAYLAND_DISPLAY is present|actually running wayland|--- WARNING ---|does not support setting window masks'
  if grep -E 'WARN|ERROR|CRIT' "$log" | grep -vE "$noise" | grep -q .; then
    echo "== $theme: qs log is not clean" >&2
    grep -E 'WARN|ERROR|CRIT' "$log" | grep -vE "$noise" | head -20 >&2
    status=1
  fi
  echo "$theme: $(grep -c 'shots: wrote' "$log") shots in shots/$theme"
done
exit $status
