#!/usr/bin/env bash
# Render the README screenshots into docs/screenshots/.
#
#   tools/readme-shots
#
# Each scene is rendered offscreen at 2x under its theme, then framed: rounded
# corners, a hairline edge and a soft shadow, on a gradient made from that
# theme's own background and accent. Needs ImageMagick (magick).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SUITE="$(cd "$ROOT/.." && pwd)"
RAW="$ROOT/shots/readme"
OUT="$SUITE/docs/screenshots/reader"
THEMES="$HOME/.local/share/omarchy/themes"
mkdir -p "$RAW" "$OUT"
export XDG_DATA_DIRS="$HOME/.local/share/omarky/ksh:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# The edit sheet's highlighter.
"$SUITE/bin/omarky" read --build >/dev/null && export QML_IMPORT_PATH="$SUITE/build/qml"

# Changes scenes read a sample git history, built fresh each run.
rm -rf "$RAW/.changes-repo"
CHANGES_FILE="$("$SUITE/samples/changes/make-repo" "$RAW/.changes-repo")"
export OMARKY_NOW="2026-10-26T10:00:00+10:00" TZ="Australia/Brisbane"

# name|theme|sample (under samples/, or an absolute path)|width|height|options (JSON)
SCENES=(
  "hero-dark|tokyo-night|kitchen-sink|1240|800|{\"outline\":true}"
  "hero-light|catppuccin-latte|code|1240|800|{\"anchor\":\"a-diff\",\"outline\":false}"
  "reading|gruvbox|prose|1320|860|{\"anchor\":\"measure\",\"outline\":true}"
  "code|rose-pine|code|1320|860|{\"anchor\":\"short-snippets\"}"
  "tables|flexoki-light|tables|1320|860|{\"anchor\":\"aligned\"}"
  "structure|tokyo-night|kitchen-sink|1320|860|{\"anchor\":\"lists\",\"outline\":true}"
  "alerts|rose-pine|alerts|1320|860|{}"
  "find|gruvbox|real/reader-spec|1320|860|{\"find\":\"quickshell\",\"reloaded\":true,\"outline\":true}"
  "changes|kanagawa|$CHANGES_FILE|1320|860|{\"from\":\"danny\",\"outline\":true,\"anchor\":\"situation\"}"
  "changes-fold|rose-pine|$CHANGES_FILE|1320|860|{\"from\":\"danny\",\"fold\":true,\"outline\":true}"
  "changes-versions|tokyo-night|$CHANGES_FILE|1320|860|{\"from\":\"danny\",\"versions\":true}"
  "edit|gruvbox|$CHANGES_FILE|1320|860|{\"from\":\"danny\",\"edit\":\"reworded\",\"outline\":true}"
)
GRID_THEMES="gruvbox tokyo-night matte-black catppuccin-latte rose-pine flexoki-light"

render() {   # theme jobs-json
  local theme="$1" jobs="$2"
  printf '%s' "$jobs" >"$RAW/.$theme.json"
  OMARKY_THEME_DIR="$THEMES/$theme" OMARKY_SHOT="$RAW/.$theme.json" OMARKY_READER_STATE_DIR="$ROOT/shots/.state" \
    QT_QPA_PLATFORM=offscreen QT_SCALE_FACTOR=2 \
    timeout 120 qs --log-rules "qt.qml.usedbeforedeclared=false" -p "$ROOT/ui/shell.qml" >"$RAW/.$theme.log" 2>&1
}

job() {   # name sample w h opts
  local file="$2"; [ "${file#/}" = "$file" ] && file="$SUITE/samples/$2.md"
  printf '{"file":"%s","name":"%s","w":%s,"h":%s,"pages":1,"opts":%s}' "$file" "$1" "$3" "$4" "$5"
}

# ---- render every scene (one qs per theme)
declare -A per_theme
for s in "${SCENES[@]}"; do
  IFS='|' read -r name theme sample w h opts <<<"$s"
  per_theme[$theme]+="${per_theme[$theme]:+,}$(job "$name" "$sample" "$w" "$h" "$opts")"
done
for theme in $GRID_THEMES; do
  per_theme[$theme]+="${per_theme[$theme]:+,}$(job "grid-$theme" kitchen-sink 1000 700 '{"anchor":"quotes","outline":false}')"
done
pids=()
for theme in "${!per_theme[@]}"; do
  render "$theme" "{\"out\":\"$RAW\",\"jobs\":[${per_theme[$theme]}]}" &
  pids+=($!)
  sleep 0.4   # simultaneous qs starts race on Quickshell's runtime symlinks
done
for p in "${pids[@]}"; do wait "$p"; done
if grep -hE 'WARN|ERROR' "$RAW"/.*.log | grep -vE 'WAYLAND_DISPLAY|actually running|--- WARNING|window masks' | grep -q .; then
  echo "qs logged warnings:" >&2
  grep -hE 'WARN|ERROR' "$RAW"/.*.log | grep -vE 'WAYLAND_DISPLAY|actually running|--- WARNING|window masks' >&2
  exit 1
fi

# ---- framing (tools/frame)
. "$SUITE/tools/frame"

for s in "${SCENES[@]}"; do
  IFS='|' read -r name theme _ <<<"$s"
  case "$name" in hero-*) continue ;; esac
  single "$RAW/$name-1.png" "$OUT/$name.png" "$theme"
done

# Hero: the light window behind and to the left, the dark one in front.
frame "$RAW/hero-light-1.png" "$RAW/.f-light.png" 28
frame "$RAW/hero-dark-1.png" "$RAW/.f-dark.png" 28
backdrop tokyo-night 3500 2340 "$RAW/.bg-hero.png"
magick "$RAW/.bg-hero.png" \
  "$RAW/.f-light.png" -geometry +80+60 -compose Over -composite \
  "$RAW/.f-dark.png" -geometry +900+560 -compose Over -composite \
  -resize 1600x -strip -define png:compression-level=9 "$OUT/hero.png"

# Themes: the same page under six themes.
tiles=()
for theme in $GRID_THEMES; do
  magick "$RAW/grid-$theme-1.png" -resize 50% "$RAW/.g-$theme.png"
  frame "$RAW/.g-$theme.png" "$RAW/.gf-$theme.png" 16
  tiles+=("$RAW/.gf-$theme.png")
done
montage "${tiles[@]}" -tile 3x2 -geometry +10+10 -background none "$RAW/.grid.png"
w=$(magick identify -format %w "$RAW/.grid.png"); h=$(magick identify -format %h "$RAW/.grid.png")
backdrop gruvbox $((w + 120)) $((h + 120)) "$RAW/.bg-grid.png"
magick "$RAW/.bg-grid.png" "$RAW/.grid.png" -gravity center -compose Over -composite \
  -resize 1600x -strip -define png:compression-level=9 "$OUT/themes.png"

ls -1 "$OUT"
