#!/usr/bin/env bash
# OmarkyReader's own tests: the command line, in Ruby. The library's suites
# are the suite's tools/test, which runs these too.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SUITE="$(cd "$ROOT/.." && pwd)"
cd "$ROOT"
status=0
for t in test/ruby/*_test.rb; do
  /usr/bin/ruby -I launcher -I "$SUITE/launcher" -I test/ruby -I "$SUITE/test/ruby" "$t" || status=1
done
exit $status
