#!/usr/bin/env bash
# The library's tests (vendor/omarky), then this app's Ruby tests.
#   tools/test            everything
#   tools/test --app      this app only
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
status=0
[ "${1:-}" = "--app" ] || "$ROOT/vendor/omarky/tools/test" || status=1
for t in test/ruby/*_test.rb; do
  /usr/bin/ruby -I launcher -I vendor/omarky/launcher -I test/ruby -I vendor/omarky/test/ruby "$t" || status=1
done
exit $status
