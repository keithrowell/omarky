[Desktop Entry]
Type=Application
Name=OmarkyWriter
GenericName=Markdown Editor
Comment=Write Markdown that looks good while you write it
Exec=omarky write %F
Icon=omarky-writer
Terminal=false
MimeType=text/markdown;
Categories=Office;TextEditor;
Keywords=markdown;md;writer;editor;byword;
StartupWMClass=omarky-writer
