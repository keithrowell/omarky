#!/usr/bin/ruby
# Build a sample git history for the proposal in samples/changes/, so an app's changes mode can
# be tried without a real client document:
#
#   samples/changes/make-repo DIR        (DIR is created; prints the document path)
#
# Eight check-ins by two authors over October 2026 lead from a first draft to
# samples/changes/proposal-after.md, with samples/changes/proposal-before.md as Danny's last
# check-in. SENT.md names a sent date between the two.
require "fileutils"

dir = ARGV[0] or abort "usage: samples/changes/make-repo DIR"
root = File.expand_path("../..", __dir__)
before = File.read(File.join(root, "samples/changes/proposal-before.md"))
after = File.read(File.join(root, "samples/changes/proposal-after.md"))

# Earlier drafts are cut-downs of the "before" text, section by section.
sections = before.split(/^(?=## )/)
def upto(sections, n) = sections.first(n).join

keith = ["Keith Rowell", "keith@example.com"]
danny = ["Danny Malone", "danny@example.com"]
commits = [
  [keith, "2026-10-07T18:20:00+10:00", "Start the proposal", upto(sections, 2)],
  [keith, "2026-10-08T08:31:00+10:00", "Situation from the call notes", upto(sections, 2) + "\nThe board wants a plan before the summer peak.\n"],
  [danny, "2026-10-17T14:50:00+10:00", "First pass at the approach", upto(sections, 3)],
  [keith, "2026-10-20T11:08:00+10:00", "Team section", upto(sections, 4)],
  [keith, "2026-10-20T15:15:00+10:00", "Commercials from the rate card", upto(sections, 5)],
  [danny, "2026-10-23T16:12:00+10:00",
   "Tighten the approach section and drop the optional fourth stage\n\nTwelve weeks reads as long for a first programme. The fourth stage belongs in a follow-on proposal once the first automation is live.",
   before],
  [keith, "2026-10-24T17:02:00+10:00", "Use the client's name rather than \"the organisation\"", after.sub("ten-week", "twelve-week").sub("weeks 1 to 3", "weeks 1 to 4").sub("weeks 4 to 6", "weeks 5 to 8").sub("weeks 7 to 10", "weeks 9 to 12")],
  [keith, "2026-10-25T09:40:00+10:00", "Stage dates and training through all three stages", after],
]

FileUtils.mkdir_p(dir)
path = File.join(dir, "proposal.md")
run = lambda do |env, *cmd|
  system(env, *cmd, chdir: dir, out: File::NULL, err: File::NULL) or abort "failed: #{cmd.join(' ')}"
end
run.call({}, "git", "init", "-q", "-b", "main")
run.call({}, "git", "config", "user.name", keith[0])
run.call({}, "git", "config", "user.email", keith[1])
File.write(File.join(dir, "SENT.md"), "# Sent\n\nSent to the client on 21 October 2026 by email.\n")
commits.each do |(name, email), date, message, text|
  File.write(path, text)
  run.call({}, "git", "add", ".")
  env = { "GIT_AUTHOR_NAME" => name, "GIT_AUTHOR_EMAIL" => email, "GIT_AUTHOR_DATE" => date,
          "GIT_COMMITTER_NAME" => name, "GIT_COMMITTER_EMAIL" => email, "GIT_COMMITTER_DATE" => date }
  run.call(env, "git", "commit", "-q", "-m", message)
end
puts path
