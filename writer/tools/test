#!/usr/bin/env bash
# Run the JS unit tests (ui/test/tst_*.qml) headless under Qt's V4 engine.
#   tools/test [-functions name…]
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT/ui"
export QT_QPA_PLATFORM=offscreen
# /usr/bin/qmltestrunner is the Qt 5 one; use Qt 6.
export QML_IMPORT_PATH="$ROOT/build/qml"
exec /usr/lib/qt6/bin/qmltestrunner -input test "$@"
