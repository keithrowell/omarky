#!/usr/bin/env bash
# Install OmaWriter for this user: fetch the library, build the native
# highlighter, put the launcher on PATH, add the desktop entry and the icon. Re-run after moving
# the repository. Does not change the default Markdown app; see the README.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
bin="$HOME/.local/bin"
apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
icons="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps"
mkdir -p "$bin" "$apps" "$icons"

git -C "$root" submodule update --init --quiet
"$root/bin/omawriter" --build

# A text/markdown handler can change which app opens Markdown when no
# default is set; keep whatever opened it before.
before="$(xdg-mime query default text/markdown 2>/dev/null || true)"

ln -sfn "$root/bin/omawriter" "$bin/omawriter"
sed -e "s|^Exec=.*|Exec=$root/bin/omawriter %F|" -e "s|^Icon=.*|Icon=omawriter|" \
  "$root/ops/omawriter.desktop" >"$apps/omawriter.desktop"
cp "$root/ops/omawriter.svg" "$icons/omawriter.svg"
command -v update-desktop-database >/dev/null && update-desktop-database -q "$apps" || true
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -qtf "${icons%/scalable/apps}" 2>/dev/null || true

after="$(xdg-mime query default text/markdown 2>/dev/null || true)"
if [ -n "$before" ] && [ "$before" != "omawriter.desktop" ] && [ "$after" != "$before" ]; then
  xdg-mime default "$before" text/markdown
  echo "Kept $before as the default for text/markdown."
fi

echo "Installed: $bin/omawriter -> $root/bin/omawriter"
echo "           $apps/omawriter.desktop"
