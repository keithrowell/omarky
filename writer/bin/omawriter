#!/usr/bin/env bash
# OmaWriter — a Markdown editor for Omarchy.
#
#   omawriter [FILE.md …]   open files (each in its own window)
#   omawriter               a new untitled document
#   omawriter --end FILE.md open with the cursor at the end, ready to add
#   omawriter --foreground  run qs in this terminal (development)
#   omawriter --version
#
# A running OmaWriter gets the files over IPC and opens new windows; this
# script exits at once. Otherwise it starts one detached qs process, logging
# to ~/.local/state/omawriter/qs.log. The native highlighter is built on
# first run (or after a change to native/) into build/.
set -euo pipefail

self="$(readlink -f "$0")"
root="$(cd "$(dirname "$self")/.." && pwd)"
state="${XDG_STATE_HOME:-$HOME/.local/state}/omawriter"
lock="${XDG_RUNTIME_DIR:-/tmp}/omawriter/${OMAWRITER_INSTANCE:-omawriter}.lock"
foreground=0
at_end=""
targets=()

for arg in "$@"; do
  case "$arg" in
    -h|--help) sed -n '2,13p' "$self" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --foreground) foreground=1; continue ;;
    --end) at_end=$'\t'end; continue ;;
    -V|--version) echo "omawriter $(cat "$root/VERSION")"; exit 0 ;;
  esac
  path="${arg#file://}"
  targets+=("$(realpath -m -- "$path")")
done
# A tab and a flag after the path travel with it to the running instance.
if [ -n "$at_end" ]; then for i in "${!targets[@]}"; do targets[$i]+="$at_end"; done; fi

# Fast path: an instance holds the lock, so hand it the files.
if [ -f "$lock" ] && ! flock -n "$lock" true 2>/dev/null; then
  pid="$(cat "$lock" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    ok=1
    if [ ${#targets[@]} -eq 0 ]; then
      qs ipc --pid "$pid" call omawriter open "" >/dev/null 2>&1 || ok=0
    else
      for t in "${targets[@]}"; do qs ipc --pid "$pid" call omawriter open "$t" >/dev/null 2>&1 || ok=0; done
    fi
    [ "$ok" = 1 ] && exit 0
  fi
fi

mkdir -p "$state"

# The native module: rebuilt when a source in native/ is newer than it, or
# when Qt has been upgraded (it uses one private Qt header, decision 0002).
module="$root/build/qml/OmaWriter/Native/libomawriternative.so"
qt="$(/usr/lib/qt6/bin/qtpaths --qt-version 2>/dev/null || true)"
if [ ! -f "$module" ] || [ -n "$(find "$root/native" -newer "$module" -type f 2>/dev/null | head -1)" ] \
   || [ "$qt" != "$(cat "$root/build/qt-version" 2>/dev/null)" ]; then
  gen=(); command -v ninja >/dev/null && gen=(-G Ninja)
  { cmake -S "$root/native" -B "$root/build" "${gen[@]}" -DCMAKE_BUILD_TYPE=Release \
      && cmake --build "$root/build"; } >"$state/build.log" 2>&1 || {
    echo "omawriter: building the native highlighter failed; see $state/build.log" >&2
    command -v notify-send >/dev/null && notify-send "OmaWriter" "Building the native highlighter failed: $state/build.log"
    exit 1
  }
  printf '%s\n' "$qt" >"$root/build/qt-version"
fi
export QML_IMPORT_PATH="$root/build/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
# The preview's code-highlighting themes, generated by OmaRead's renderer.
export XDG_DATA_DIRS="$HOME/.local/share/omaread/ksh:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

export OMAWRITER_OPEN="$(printf '%s\n' "${targets[@]+"${targets[@]}"}")"
qs_args=(--log-rules "qt.qml.usedbeforedeclared=false;qt.qpa.services.warning=false" -p "$root/ui/shell.qml")
if [ "$foreground" = 1 ]; then
  exec qs "${qs_args[@]}"
fi
setsid -f qs "${qs_args[@]}" >"$state/qs.log" 2>&1 </dev/null
