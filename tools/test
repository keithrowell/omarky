#!/usr/bin/env bash
# Every test in the suite: the library's QML suites (test/tst_*.qml) under
# Qt's V4 engine with the native highlighter built into build/ first, the
# library's Ruby suites, then OmarkyReader's command-line suite.
#   tools/test                            everything
#   tools/test -input test/tst_words.qml  one QML suite
#   tools/test --ruby                     Ruby only
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
export QT_QPA_PLATFORM=offscreen QML_XHR_ALLOW_FILE_READ=1
# The minified vendor/markdown-it.js trips a declaration-order lint; it is valid JS.
export QT_LOGGING_RULES="qt.qml.usedbeforedeclared=false"
status=0
if [ "${1:-}" != "--ruby" ]; then
  import="$(/usr/bin/ruby -I launcher -e 'require "omarky"; p = Omarky::Native.new(root: ".", source: "native", state_dir: "build").ensure; puts p if p' 2>/dev/null || true)"
  if [ -n "$import" ]; then
    export QML_IMPORT_PATH="$ROOT/$import"
    # /usr/bin/qmltestrunner is the Qt 5 one; use Qt 6.
    /usr/lib/qt6/bin/qmltestrunner -input test "$@" || status=1
  else
    echo "tools/test: no native module (cmake missing or the build failed, see build/build.log); skipping tst_highlighter"
    if [ $# -eq 0 ]; then
      for f in test/tst_*.qml; do
        [ "$f" = test/tst_highlighter.qml ] && continue
        /usr/lib/qt6/bin/qmltestrunner -input "$f" || status=1
      done
    else
      /usr/lib/qt6/bin/qmltestrunner "$@" || status=1
    fi
  fi
fi
[ "${1:-}" = "--ruby" ] && shift
if [ $# -eq 0 ]; then
  for t in test/ruby/*_test.rb; do /usr/bin/ruby -I launcher -I test/ruby "$t" || status=1; done
  reader/tools/test || status=1
fi
exit $status
