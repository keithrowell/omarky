#!/usr/bin/env python3
"""Regenerate samples/long.md: 5,000+ lines built from the other samples,
numbered into chapters so the outline and scroll-spy have work to do."""
import pathlib, re

root = pathlib.Path(__file__).resolve().parent.parent
samples = root / "samples"

def body(name):
    text = (samples / name).read_text()
    text = re.sub(r"\A---\n.*?\n---\n", "", text, flags=re.S)   # drop front matter
    text = re.sub(r"^\[\^(\w+)\]:.*(\n    .*)*", "", text, flags=re.M)   # drop footnote defs
    text = re.sub(r"\[\^\w+\]", "", text)
    return re.sub(r"^(#{1,5}) ", r"#\1 ", text, flags=re.M)   # demote headings one level

parts = ["# A Very Long Document\n\nFive thousand lines and more, stitched from the other samples, "
         "to check that the reader opens big files quickly and scrolls them smoothly.\n"]
sources = ["prose.md", "code.md", "tables.md", "alerts.md", "kitchen-sink.md"]
n = 0
while sum(p.count("\n") for p in parts) < 5200:
    src = sources[n % len(sources)]
    n += 1
    parts.append(f"\n# Chapter {n}: {src[:-3].replace('-', ' ').title()}\n\n" + body(src))
(samples / "long.md").write_text("".join(parts))
print(f"samples/long.md: {sum(p.count(chr(10)) for p in parts)} lines, {n} chapters")
